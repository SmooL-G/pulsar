# Pulsar Home — environment template.
# Copy to `.env` and fill in values (install.sh generates secrets for you
# the first time it runs).

# === Identity ===
# Unique ID for this Home device. Generated once at first boot, used by
# the coordinator to track this node. Format: home-<random12>.
HOME_INSTANCE_ID=home-changeme1234

# Where the coordinator (Pulsar mothership) lives. For dev you can point
# at a local coordinator; in prod leave the default.
COORDINATOR_URL=https://pulsar-chat.fun

# === Data location ===
# Where Pulsar Home stores Postgres / Redis / MinIO / shard files.
# Default works for RPi / Ubuntu. Override if you mounted an SSD elsewhere.
PULSAR_HOME_DATA=/var/lib/pulsar-home

# === Database / Cache ===
DB_PASSWORD=
REDIS_PASSWORD=

# === Auth secrets ===
JWT_SECRET=
JWT_REFRESH_SECRET=
WALLET_ENCRYPTION_SALT=

# === Local S3 (MinIO) ===
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public URL through which clients fetch media. Defaults to LAN proxy.
S3_PUBLIC_URL=http://pulsar.local/media

# === Solana ===
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
PLATFORM_WALLET_ADDRESS=

# === Web client / CORS ===
CORS_ORIGIN=http://pulsar.local

# === Push notifications (optional) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@pulsar.local

# === Email (optional) ===
SMTP_FROM=noreply@pulsar.local

# === AI features (optional) — leave blank to disable ===
KIE_API_KEY=
OPENAI_API_KEY=

# === Node-agent ===
HEARTBEAT_INTERVAL_SEC=30
# Set MOCK_SIGN=false once an ATECC608B is wired to the device.
# When true, node-agent uses an in-memory Ed25519 key (development only).
MOCK_SIGN=true
