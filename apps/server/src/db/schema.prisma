generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  walletAddress       String     @unique @map("wallet_address")
  walletType          WalletType @default(CUSTODIAL) @map("wallet_type")
  encryptedPrivateKey String?    @map("encrypted_private_key")
  email               String?    @unique
  passwordHash        String?    @map("password_hash")
  username            String     @unique @db.VarChar(32)
  displayName         String?    @map("display_name") @db.VarChar(64)
  avatarUrl           String?    @map("avatar_url")
  nftAvatarMint       String?    @map("nft_avatar_mint")
  bio                 String?    @db.VarChar(256)
  socialLinks         Json?      @map("social_links") @db.JsonB
  profileBadge        String?    @map("profile_badge") @db.VarChar(20)
  nickColor           String?    @map("nick_color") @db.VarChar(7)
  verificationLevel   Int        @default(0) @map("verification_level") @db.SmallInt
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  lastSeenAt          DateTime?  @map("last_seen_at")
  isOnline            Boolean    @default(false) @map("is_online")
  isBot               Boolean    @default(false) @map("is_bot")
  // Quiet hours for push notifications. Stored as minutes-from-midnight
  // (0-1439) in the user's local timezone (IANA name). All three required
  // for the mute window to apply; otherwise pushes go through 24/7.
  pushMuteFrom        Int?       @map("push_mute_from") @db.SmallInt
  pushMuteTo          Int?       @map("push_mute_to") @db.SmallInt
  pushMuteTimezone    String?    @map("push_mute_timezone") @db.VarChar(64)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  sentMessages      Message[]
  chatMembers       ChatMember[]
  ownedGroups       Chat[]             @relation("owner")
  fileUploads       FileAttachment[]
  readReceipts      ReadReceipt[]
  sessions          Session[]
  notifications     Notification[]
  sentRequests      Friendship[]       @relation("requester")
  receivedRequests  Friendship[]       @relation("addressee")
  plsWallet         PlsWallet?
  keyBundle         UserKeyBundle?
  botProfile        Bot?               @relation("botUser")
  ownedBots         Bot[]              @relation("botOwner")
  reports           Report[]
  punishments       UserPunishment[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

enum WalletType {
  EXTERNAL
  CUSTODIAL
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

// ─── AUTH SESSIONS ───────────────────────────────────────

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── CHATS ───────────────────────────────────────────────

model Chat {
  id          String   @id @default(uuid()) @db.Uuid
  type        ChatType
  name        String?  @db.VarChar(128)
  description String?  @db.VarChar(512)
  avatarUrl   String?  @map("avatar_url")
  inviteCode  String?  @unique @map("invite_code") @db.VarChar(16)
  ownerId     String?  @map("owner_id") @db.Uuid
  maxMembers  Int      @default(500) @map("max_members")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner          User?           @relation("owner", fields: [ownerId], references: [id])
  members        ChatMember[]
  messages       Message[]
  pinnedMessages PinnedMessage[]
  isModChannel   Boolean  @default(false) @map("is_mod_channel")
  allowComments  Boolean  @default(true) @map("allow_comments")
  sourceMessage  Message? @relation("commentChat")

  @@index([type])
  @@index([inviteCode])
  @@map("chats")
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
  SAVED
}

model ChatMember {
  id       String     @id @default(uuid()) @db.Uuid
  chatId   String     @map("chat_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     MemberRole @default(MEMBER)
  mutedUntil DateTime? @map("muted_until")
  joinedAt DateTime   @default(now()) @map("joined_at")
  leftAt   DateTime?  @map("left_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

enum MemberRole {
  MEMBER
  AUTHOR
  MODERATOR
  ADMIN
  OWNER
}

// ─── MESSAGES ────────────────────────────────────────────

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  chatId    String      @map("chat_id") @db.Uuid
  senderId  String      @map("sender_id") @db.Uuid
  content   String?     @db.Text
  type      MessageType @default(TEXT)
  replyToId String?     @map("reply_to_id") @db.Uuid
  isEdited  Boolean     @default(false) @map("is_edited")
  isDeleted Boolean     @default(false) @map("is_deleted")
  metadata     Json?
  signature        String?  @db.VarChar(128)
  signerWallet     String?  @map("signer_wallet") @db.VarChar(64)
  encryptedContent String?  @map("encrypted_content") @db.Text
  encryptionType   String?  @map("encryption_type") @db.VarChar(32)
  commentsEnabled  Boolean  @default(false) @map("comments_enabled")
  commentChatId    String?  @unique @map("comment_chat_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  chat         Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id])
  replyTo      Message?          @relation("replies", fields: [replyToId], references: [id])
  replies      Message[]         @relation("replies")
  attachments     FileAttachment[]
  readReceipts    ReadReceipt[]
  reactions       Reaction[]
  checklistChecks ChecklistCheck[]
  pollVotes       PollVote[]
  pinned       PinnedMessage?
  reports      Report[]
  commentChat  Chat?             @relation("commentChat", fields: [commentChatId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
  VOICE
  VIDEO
  CHECKLIST
  POLL
}

// ─── FILES ───────────────────────────────────────────────

model FileAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  uploaderId   String   @map("uploader_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSize     BigInt   @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(128)
  s3Key        String   @map("s3_key")
  s3Bucket     String   @map("s3_bucket") @db.VarChar(64)
  thumbnailKey String?  @map("thumbnail_key")
  width        Int?
  height       Int?
  duration     Int?
  createdAt    DateTime @default(now()) @map("created_at")

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([messageId])
  @@map("file_attachments")
}

// ─── READ RECEIPTS ───────────────────────────────────────

model ReadReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("read_receipts")
}

// ─── REACTIONS ───────────────────────────────────────────

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("reactions")
}

// ─── CHECKLISTS ───────────────────────────────────────────
// A check record means "this user marked item <itemId> on message <messageId>
// as done". Toggling re-uses the unique index: a second POST from the same
// user on the same item deletes the row.
model ChecklistCheck {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  itemId    String   @map("item_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, itemId, userId])
  @@index([messageId])
  @@map("checklist_checks")
}

// ─── SCHEDULED MESSAGES ───────────────────────────────────
// Drafts that the scheduler worker materializes into real Message rows
// at sendAt. attachments + metadata are stored as JSON so the worker
// can replay the message:send logic without re-uploading anything.
model ScheduledMessage {
  id          String      @id @default(uuid()) @db.Uuid
  chatId      String      @map("chat_id") @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  content     String?     @db.Text
  type        MessageType @default(TEXT)
  metadata    Json?
  attachments Json?       @db.JsonB
  sendAt      DateTime    @map("send_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([sendAt])
  @@index([senderId])
  @@map("scheduled_messages")
}

// ─── POLLS ────────────────────────────────────────────────
// Every vote is one row. Single-choice polls delete the previous vote on
// new selection; multi-choice polls toggle per-option (same user can
// have many rows on the same message).
model PollVote {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  optionId  String   @map("option_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, optionId, userId])
  @@index([messageId])
  @@map("poll_votes")
}

// ─── PINNED MESSAGES ─────────────────────────────────────

model PinnedMessage {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  messageId String   @unique @map("message_id") @db.Uuid
  pinnedBy  String   @map("pinned_by") @db.Uuid
  pinnedAt  DateTime @default(now()) @map("pinned_at")

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("pinned_messages")
}

// ─── FRIENDSHIPS ────────────────────────────────────────

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// ─── NOTIFICATIONS ───────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(128)
  body      String?          @db.VarChar(512)
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  MESSAGE
  MENTION
  GROUP_INVITE
  SYSTEM
}

// ─── PLS WALLET ─────────────────────────────────────────

model PlsWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PlsTransaction[]

  @@map("pls_wallets")
}

model PlsTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  walletId     String            @map("wallet_id") @db.Uuid
  type         PlsTransactionType
  amount       BigInt
  solAmount    Decimal?          @map("sol_amount") @db.Decimal(18, 9)
  solSignature String?           @unique @map("sol_signature")
  description  String?           @db.VarChar(256)
  status       PlsTransactionStatus @default(COMPLETED)
  createdAt    DateTime          @default(now()) @map("created_at")

  wallet PlsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@map("pls_transactions")
}

enum PlsTransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  REWARD
  TRANSFER
}

enum PlsTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── E2E KEY BUNDLES ────────────────────────────────────

model UserKeyBundle {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @unique @map("user_id") @db.Uuid
  identityKeyPub  String @map("identity_key_pub")
  preKeyPub       String @map("pre_key_pub")
  preKeySignature String @map("pre_key_signature")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_key_bundles")
}

// ─── NFT CACHE ──────────────────────────────────────────

model NftCache {
  id           String   @id @default(uuid()) @db.Uuid
  mintAddress  String   @unique @map("mint_address") @db.VarChar(64)
  ownerWallet  String   @map("owner_wallet") @db.VarChar(64)
  name         String?  @db.VarChar(128)
  imageUrl     String?  @map("image_url")
  collection   String?  @db.VarChar(64)
  lastVerified DateTime @default(now()) @map("last_verified")

  @@index([ownerWallet])
  @@map("nft_cache")
}

// ─── BOTS ───────────────────────────────────────────────

model Bot {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  tokenHash       String    @map("token_hash")
  tokenPlain      String?   @map("token_plain")
  startMessage    String?   @map("start_message") @db.VarChar(512)
  webhookUrl      String?   @map("webhook_url")
  webhookSecret   String?   @map("webhook_secret")
  commands        Json?     @default("[]")
  isActive        Boolean   @default(true) @map("is_active")
  isSystemBot     Boolean   @default(false) @map("is_system_bot")
  lastSeenAt      DateTime? @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user    User        @relation("botUser", fields: [userId], references: [id], onDelete: Cascade)
  owner   User        @relation("botOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  updates BotUpdate[]

  @@index([ownerId])
  @@map("bots")
}

model BotUpdate {
  id        String   @id @default(uuid()) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  type      String   @db.VarChar(32)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt(sort: Desc)])
  @@map("bot_updates")
}

// ─── MODERATION ─────────────────────────────────────────

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  messageId  String       @map("message_id") @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reason     ReportReason
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")

  message     Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter    User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  votes       ModVote[]
  punishments UserPunishment[]

  @@index([status])
  @@index([messageId])
  @@map("reports")
}

model ModVote {
  id          String     @id @default(uuid()) @db.Uuid
  reportId    String     @map("report_id") @db.Uuid
  moderatorId String     @map("moderator_id") @db.Uuid
  verdict     ModVerdict
  createdAt   DateTime   @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, moderatorId])
  @@map("mod_votes")
}

model UserPunishment {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      PunishmentType
  expiresAt DateTime?      @map("expires_at")
  reason    String?        @db.VarChar(256)
  reportId  String?        @map("report_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_punishments")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @map("user_agent") @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum ReportReason {
  SPAM
  HARASSMENT
  ILLEGAL
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED_WARN
  RESOLVED_MUTE
  RESOLVED_BAN
  DISMISSED
}

enum ModVerdict {
  WARN
  MUTE_1H
  MUTE_24H
  MUTE_7D
  BAN_30D
  BAN_PERM
  DISMISS
}

enum PunishmentType {
  WARN
  MUTE
  BAN
}
