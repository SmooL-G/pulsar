generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  walletAddress       String     @unique @map("wallet_address")
  walletType          WalletType @default(CUSTODIAL) @map("wallet_type")
  encryptedPrivateKey String?    @map("encrypted_private_key")
  email               String?    @unique
  passwordHash        String?    @map("password_hash")
  username            String     @unique @db.VarChar(32)
  displayName         String?    @map("display_name") @db.VarChar(64)
  avatarUrl           String?    @map("avatar_url")
  nftAvatarMint       String?    @map("nft_avatar_mint")
  bio                 String?    @db.VarChar(256)
  socialLinks         Json?      @map("social_links") @db.JsonB
  profileBadge        String?    @map("profile_badge") @db.VarChar(20)
  nickColor           String?    @map("nick_color") @db.VarChar(7)
  // Last time the user changed their username. Used to enforce a 30-day
  // cooldown — anti-impersonation, also discourages handle squatting.
  usernameChangedAt   DateTime?  @map("username_changed_at")
  // Profile cosmetics — purchased for PLS, see customization.routes.ts.
  // Stored as preset IDs (avatarFrame, profileBg) or hex (bubbleColor)
  // so the rendering layer can change visuals without DB migrations.
  avatarFrame         String?    @map("avatar_frame") @db.VarChar(16)
  bubbleColor         String?    @map("bubble_color") @db.VarChar(7)
  profileBg           String?    @map("profile_bg") @db.VarChar(16)
  verificationLevel   Int        @default(0) @map("verification_level") @db.SmallInt
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  lastSeenAt          DateTime?  @map("last_seen_at")
  isOnline            Boolean    @default(false) @map("is_online")
  isBot               Boolean    @default(false) @map("is_bot")
  // Quiet hours for push notifications. Stored as minutes-from-midnight
  // (0-1439) in the user's local timezone (IANA name). All three required
  // for the mute window to apply; otherwise pushes go through 24/7.
  pushMuteFrom        Int?       @map("push_mute_from") @db.SmallInt
  pushMuteTo          Int?       @map("push_mute_to") @db.SmallInt
  pushMuteTimezone    String?    @map("push_mute_timezone") @db.VarChar(64)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  // ─── Referral system ──────────────────────────────────────
  // Generated on signup, used in invite links (?ref=<code>).
  // Stays empty until the first /referrals/mine call → first user
  // ever queried, before that no need to clutter the index.
  referralCode        String?    @unique @map("referral_code") @db.VarChar(16)
  // Who invited this user (set at signup if ?ref= was valid).
  referredById        String?    @map("referred_by_id") @db.Uuid
  referredBy          User?      @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]     @relation("UserReferrals")
  // Monotonic rank used to assign the registration-bonus tier
  // (1-100 = 200 PLS, 101-1000 = 40, 1001-10000 = 10, else 0).
  // Atomically incremented at signup so we don't have to recount.
  signupRank          Int        @default(0) @map("signup_rank")
  // True once the registration bonus has been credited (after the
  // user reaches Verification Level 1 — anti-empty-account gate).
  referralBonusPaid   Boolean    @default(false) @map("referral_bonus_paid")

  sentMessages      Message[]
  chatMembers       ChatMember[]
  ownedGroups       Chat[]             @relation("owner")
  fileUploads       FileAttachment[]
  readReceipts      ReadReceipt[]
  sessions          Session[]
  notifications     Notification[]
  sentRequests      Friendship[]       @relation("requester")
  receivedRequests  Friendship[]       @relation("addressee")
  plsWallet         PlsWallet?
  keyBundle         UserKeyBundle?
  devices           UserDevice[]
  p2pOffers         P2POffer[]
  p2pBuyerTrades    P2PTrade[]         @relation("p2pBuyerTrades")
  p2pSellerTrades   P2PTrade[]         @relation("p2pSellerTrades")
  botProfile        Bot?               @relation("botUser")
  ownedBots         Bot[]              @relation("botOwner")
  reports           Report[]
  punishments       UserPunishment[]
  pushSubscriptions PushSubscription[]
  subscription      Subscription?

  // Set to true the first time the user activates the Premium 7-day trial
  // so they cannot start it again on a second account roundtrip.
  premiumTrialUsed  Boolean @default(false) @map("premium_trial_used")

  @@map("users")
}

enum WalletType {
  EXTERNAL
  CUSTODIAL
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

// ─── AUTH SESSIONS ───────────────────────────────────────

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── CHATS ───────────────────────────────────────────────

model Chat {
  id          String   @id @default(uuid()) @db.Uuid
  type        ChatType
  name        String?  @db.VarChar(128)
  description String?  @db.VarChar(512)
  avatarUrl   String?  @map("avatar_url")
  inviteCode  String?  @unique @map("invite_code") @db.VarChar(16)
  ownerId     String?  @map("owner_id") @db.Uuid
  maxMembers  Int      @default(500) @map("max_members")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner          User?           @relation("owner", fields: [ownerId], references: [id])
  members        ChatMember[]
  messages       Message[]
  pinnedMessages PinnedMessage[]
  boosts         ChannelBoost[]
  isModChannel   Boolean  @default(false) @map("is_mod_channel")
  allowComments  Boolean  @default(true) @map("allow_comments")
  sourceMessage  Message? @relation("commentChat")

  @@index([type])
  @@index([inviteCode])
  @@map("chats")
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
  SAVED
}

model ChatMember {
  id       String     @id @default(uuid()) @db.Uuid
  chatId   String     @map("chat_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  role     MemberRole @default(MEMBER)
  mutedUntil DateTime? @map("muted_until")
  joinedAt DateTime   @default(now()) @map("joined_at")
  leftAt   DateTime?  @map("left_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

enum MemberRole {
  MEMBER
  AUTHOR
  MODERATOR
  ADMIN
  OWNER
}

// ─── MESSAGES ────────────────────────────────────────────

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  chatId    String      @map("chat_id") @db.Uuid
  senderId  String      @map("sender_id") @db.Uuid
  content   String?     @db.Text
  type      MessageType @default(TEXT)
  replyToId String?     @map("reply_to_id") @db.Uuid
  isEdited  Boolean     @default(false) @map("is_edited")
  isDeleted Boolean     @default(false) @map("is_deleted")
  metadata     Json?
  signature        String?  @db.VarChar(128)
  signerWallet     String?  @map("signer_wallet") @db.VarChar(64)
  encryptedContent String?  @map("encrypted_content") @db.Text
  encryptionType   String?  @map("encryption_type") @db.VarChar(32)
  commentsEnabled  Boolean  @default(false) @map("comments_enabled")
  commentChatId    String?  @unique @map("comment_chat_id") @db.Uuid
  // SuperChat: paid highlighted message in groups/channels. amount > 0
  // means this is a SuperChat; pinnedUntil drives the "pinned" state at
  // render time (no separate row in pinned_messages — purely virtual).
  superchatAmount  BigInt?  @map("superchat_amount")
  superchatTier    String?  @map("superchat_tier") @db.VarChar(8) // blue|green|yellow|red
  pinnedUntil      DateTime? @map("pinned_until")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  chat         Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id])
  replyTo      Message?          @relation("replies", fields: [replyToId], references: [id])
  replies      Message[]         @relation("replies")
  attachments     FileAttachment[]
  readReceipts    ReadReceipt[]
  reactions       Reaction[]
  checklistChecks ChecklistCheck[]
  pollVotes       PollVote[]
  pinned       PinnedMessage?
  reports      Report[]
  commentChat  Chat?             @relation("commentChat", fields: [commentChatId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
  VOICE
  VIDEO
  CHECKLIST
  POLL
  SUPERCHAT
}

// ─── FILES ───────────────────────────────────────────────

model FileAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  uploaderId   String   @map("uploader_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSize     BigInt   @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(128)
  s3Key        String   @map("s3_key")
  s3Bucket     String   @map("s3_bucket") @db.VarChar(64)
  thumbnailKey String?  @map("thumbnail_key")
  width        Int?
  height       Int?
  duration     Int?
  createdAt    DateTime @default(now()) @map("created_at")

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([messageId])
  @@map("file_attachments")
}

// ─── READ RECEIPTS ───────────────────────────────────────

model ReadReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("read_receipts")
}

// ─── REACTIONS ───────────────────────────────────────────

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("reactions")
}

// ─── CHECKLISTS ───────────────────────────────────────────
// A check record means "this user marked item <itemId> on message <messageId>
// as done". Toggling re-uses the unique index: a second POST from the same
// user on the same item deletes the row.
model ChecklistCheck {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  itemId    String   @map("item_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, itemId, userId])
  @@index([messageId])
  @@map("checklist_checks")
}

// ─── CHANNEL/GROUP REVENUE SHARE ──────────────────────────
// One row per chat per daily distribution. Lets us build a transparent
// "your communities earned X PLS this week" report.
model RevenueDistribution {
  id              String   @id @default(uuid()) @db.Uuid
  chatId          String   @map("chat_id") @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  amount          BigInt
  activeCount     Int      @map("active_count")
  distributedAt   DateTime @default(now()) @map("distributed_at")

  @@index([chatId, distributedAt])
  @@index([ownerId, distributedAt])
  @@map("revenue_distributions")
}

// ─── DAILY LOTTERY ────────────────────────────────────────
// Two drawings per day (one per pool). winnerId references the user
// that received `amount` PLS; candidatesCount is logged for transparency.
model LotteryDraw {
  id              String   @id @default(uuid()) @db.Uuid
  pool            String   @db.VarChar(16) // 'main' | 'small'
  winnerId        String   @map("winner_id") @db.Uuid
  amount          BigInt
  candidatesCount Int      @map("candidates_count")
  drawnAt         DateTime @default(now()) @map("drawn_at")

  @@index([drawnAt])
  @@index([winnerId])
  @@map("lottery_draws")
}

// ─── STAKING ──────────────────────────────────────────────
// Locked PLS that earns yield from the bank's rewards pool. amount is
// the principal; rewardEstimate is recorded at creation for the UI but
// the authoritative reward is computed at withdraw time. Early
// withdraw forfeits all reward AND 50% of principal.
model Stake {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  amount          BigInt       // principal locked, PLS
  lockDays        Int          @map("lock_days") @db.SmallInt
  apyBps          Int          @map("apy_bps") @db.SmallInt // basis points (200 = 2%)
  startedAt       DateTime     @default(now()) @map("started_at")
  maturesAt       DateTime     @map("matures_at")
  status          StakeStatus  @default(ACTIVE)
  withdrawnAt     DateTime?    @map("withdrawn_at")
  withdrawnAmount BigInt?      @map("withdrawn_amount")
  rewardPaid      BigInt?      @map("reward_paid")

  @@index([userId, status])
  @@index([status, maturesAt])
  @@map("stakes")
}

enum StakeStatus {
  ACTIVE
  WITHDRAWN
  EARLY_WITHDRAWN
}

// ─── PLS PURCHASES (YooKassa) ─────────────────────────────
// One row per YooKassa payment. Created PENDING, transitioned to PAID
// (and PLS credited) by webhook OR by an idempotent /check-payment
// callback when the user lands back from YooKassa's confirmation page.
model PlsPurchase {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  amountPls          BigInt        @map("amount_pls")
  amountRub          Int           @map("amount_rub")
  yookassaPaymentId  String        @unique @map("yookassa_payment_id") @db.VarChar(64)
  status             String        @default("PENDING") @db.VarChar(16) // PENDING | PAID | CANCELLED
  paidAt             DateTime?     @map("paid_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("pls_purchases")
}

// ─── PREMIUM SUBSCRIPTION ─────────────────────────────────
// One row per user; absence == not subscribed. expiresAt is the source
// of truth for "is currently premium". autoRenew controls whether the
// daily worker tries to charge again before expiry. isTrial flags the
// 7-day free trial so we can distinguish trial vs paid in analytics.
model Subscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  plan      String   @default("premium") @db.VarChar(20)
  expiresAt DateTime @map("expires_at")
  autoRenew Boolean  @default(true) @map("auto_renew")
  isTrial   Boolean  @default(false) @map("is_trial")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("subscriptions")
}

// ─── SCHEDULED MESSAGES ───────────────────────────────────
// Drafts that the scheduler worker materializes into real Message rows
// at sendAt. attachments + metadata are stored as JSON so the worker
// can replay the message:send logic without re-uploading anything.
model ScheduledMessage {
  id          String      @id @default(uuid()) @db.Uuid
  chatId      String      @map("chat_id") @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  content     String?     @db.Text
  type        MessageType @default(TEXT)
  metadata    Json?
  attachments Json?       @db.JsonB
  sendAt      DateTime    @map("send_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([sendAt])
  @@index([senderId])
  @@map("scheduled_messages")
}

// ─── POLLS ────────────────────────────────────────────────
// Every vote is one row. Single-choice polls delete the previous vote on
// new selection; multi-choice polls toggle per-option (same user can
// have many rows on the same message).
model PollVote {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  optionId  String   @map("option_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, optionId, userId])
  @@index([messageId])
  @@map("poll_votes")
}

// ─── TREASURY VOTES ───────────────────────────────────────
// Community proposals funded by a 1000 PLS deposit. Voting power is
// quadratic (sqrt of voter's PLS balance) to dilute whales. Status
// transitions: ACTIVE -> PASSED | FAILED | NO_QUORUM by the worker
// after endsAt. yesPower/noPower track aggregate quadratic power.
// voterCount is the unique-voter quorum threshold.
model Proposal {
  id          String         @id @default(uuid()) @db.Uuid
  authorId    String         @map("author_id") @db.Uuid
  title       String         @db.VarChar(120)
  description String         @db.Text
  status      ProposalStatus @default(ACTIVE)
  deposit     BigInt
  startedAt   DateTime       @default(now()) @map("started_at")
  endsAt      DateTime       @map("ends_at")
  resolvedAt  DateTime?      @map("resolved_at")
  yesPower    BigInt         @default(0) @map("yes_power")
  noPower     BigInt         @default(0) @map("no_power")
  voterCount  Int            @default(0) @map("voter_count")

  votes ProposalVote[]

  @@index([status, endsAt])
  @@index([authorId])
  @@map("proposals")
}

enum ProposalStatus {
  ACTIVE
  PASSED
  FAILED
  NO_QUORUM
}

model ProposalVote {
  id          String   @id @default(uuid()) @db.Uuid
  proposalId  String   @map("proposal_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  choice      String   @db.VarChar(8) // 'yes' | 'no'
  votingPower BigInt   @map("voting_power")
  createdAt   DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([proposalId])
  @@map("proposal_votes")
}

// ─── CHANNEL/GROUP BOOSTS ─────────────────────────────────
// Discord-style: members spend PLS to boost a channel/group, unlocking
// perks for everyone. One row = one 30-day slot. Multiple slots per
// user are allowed (no unique on (chatId,userId)). Expired rows stay
// in the table for "this user has boosted N times historically" stats
// but the level computation only counts rows with expiresAt > now().
model ChannelBoost {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    BigInt   // PLS paid (snapshot in case price changes)
  startedAt DateTime @default(now()) @map("started_at")
  expiresAt DateTime @map("expires_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, expiresAt])
  @@index([userId, expiresAt])
  @@map("channel_boosts")
}

// ─── DESKTOP RELAY NODES (P2P Phase 3) ────────────────────
// A user-operated signaling relay registered with the platform. Owner
// runs apps/relay (or the bundled runner) on their machine, submits
// proof-of-uptime every few minutes; daily worker pays out PLS from
// the Node Rewards Pool. token is the per-node bearer secret returned
// at registration — proofs are authenticated with it (no Solana sig
// required for MVP; token rotation handles compromise).
model RelayNode {
  id                  String   @id @default(uuid()) @db.Uuid
  ownerId             String   @map("owner_id") @db.Uuid
  // Public WebSocket endpoint, e.g. wss://my-house.example.com/ws.
  // Optional: a user can run a private node and still earn rewards
  // without exposing it (just relaying for friends doesn't count).
  endpoint            String?  @db.VarChar(256)
  label               String?  @db.VarChar(64)   // user's nickname for the node
  token               String   @unique @db.VarChar(64)
  status              String   @default("ACTIVE") @db.VarChar(16) // ACTIVE | BANNED | STALE
  registeredAt        DateTime @default(now()) @map("registered_at")
  lastSeenAt          DateTime @default(now()) @map("last_seen_at")
  // Lifetime aggregates (incremented as proofs come in).
  totalUptimeMinutes  Int      @default(0) @map("total_uptime_minutes")
  totalBytesRelayed   BigInt   @default(0) @map("total_bytes_relayed")
  totalRewardsPaid    BigInt   @default(0) @map("total_rewards_paid")

  proofs  NodeUptimeProof[]
  rewards NodeReward[]

  @@index([ownerId])
  @@index([status, lastSeenAt])
  @@map("relay_nodes")
}

model NodeUptimeProof {
  id                String   @id @default(uuid()) @db.Uuid
  nodeId            String   @map("node_id") @db.Uuid
  bytesRelayed      BigInt   @default(0) @map("bytes_relayed")   // since last proof
  activeConnections Int      @default(0) @map("active_connections")
  uniquePeers       Int      @default(0) @map("unique_peers")    // since last proof
  submittedAt       DateTime @default(now()) @map("submitted_at")

  node RelayNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, submittedAt])
  @@map("node_uptime_proofs")
}

model NodeReward {
  id            String   @id @default(uuid()) @db.Uuid
  nodeId        String   @map("node_id") @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  amount        BigInt
  uptimeMinutes Int      @map("uptime_minutes")
  bytesRelayed  BigInt   @map("bytes_relayed")
  uniquePeers   Int      @map("unique_peers")
  paidAt        DateTime @default(now()) @map("paid_at")    // earning date
  // Reward is frozen until availableAt. Owner sees it as "pending" until
  // the release worker credits the wallet. released is set when the
  // wallet credit + plsTransaction row both land.
  availableAt   DateTime @map("available_at")
  released      Boolean  @default(false)
  releasedAt    DateTime? @map("released_at")

  node RelayNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([ownerId, paidAt])
  @@index([nodeId, paidAt])
  @@index([released, availableAt])
  @@map("node_rewards")
}

// ─── REFERRAL EARNINGS LEDGER ─────────────────────────────

enum ReferralEarningType {
  REGISTRATION   // tier-based one-shot bonus (200 / 40 / 10 / 0 PLS)
  MINING_L1      // 10% from a direct referral's mined PLS
  MINING_L2      // 2% from a referral-of-referral's mined PLS
}

model ReferralEarning {
  id              String              @id @default(uuid()) @db.Uuid
  // Who gets paid (the referrer in MINING_*; either party in REGISTRATION).
  earnerId        String              @map("earner_id") @db.Uuid
  // Whose activity triggered this payment (the new user / the miner).
  refereeId       String              @map("referee_id") @db.Uuid
  type            ReferralEarningType
  amount          BigInt
  // For MINING_L1/L2 — the NodeReward row that triggered this share.
  // Lets us audit "this 5 PLS came from that 50-PLS reward".
  sourceRewardId  String?             @map("source_reward_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([earnerId, createdAt])
  @@index([refereeId, type])
  @@map("referral_earnings")
}

// ─── PINNED MESSAGES ─────────────────────────────────────

model PinnedMessage {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  messageId String   @unique @map("message_id") @db.Uuid
  pinnedBy  String   @map("pinned_by") @db.Uuid
  pinnedAt  DateTime @default(now()) @map("pinned_at")

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("pinned_messages")
}

// ─── FRIENDSHIPS ────────────────────────────────────────

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// ─── NOTIFICATIONS ───────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(128)
  body      String?          @db.VarChar(512)
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  MESSAGE
  MENTION
  GROUP_INVITE
  SYSTEM
}

// ─── PLS WALLET ─────────────────────────────────────────

model PlsWallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   BigInt   @default(0)
  // PLS held in P2P escrow (active SELL offers + open trades). Spendable
  // balance = balance - lockedAmount. Always increases when an offer is
  // posted or trade opened; decreases on cancel (returned) or release
  // (transferred to buyer).
  lockedAmount BigInt @default(0) @map("locked_amount")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PlsTransaction[]

  @@map("pls_wallets")
}

model PlsTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  walletId     String            @map("wallet_id") @db.Uuid
  type         PlsTransactionType
  amount       BigInt
  solAmount    Decimal?          @map("sol_amount") @db.Decimal(18, 9)
  solSignature String?           @unique @map("sol_signature")
  description  String?           @db.VarChar(256)
  status       PlsTransactionStatus @default(COMPLETED)
  createdAt    DateTime          @default(now()) @map("created_at")

  wallet PlsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@map("pls_transactions")
}

enum PlsTransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  REWARD
  TRANSFER
}

enum PlsTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── P2P MARKETPLACE ────────────────────────────────────
// Internal exchange where users sell PLS to other users for off-platform
// fiat (СБП / USDT / PayPal / etc). Seller's PLS is escrowed until the
// buyer marks payment received and the seller confirms.

enum P2POfferStatus {
  ACTIVE      // listed, accepting trades
  PAUSED      // hidden from marketplace, can be resumed
  COMPLETED   // remainingAmount = 0
  CANCELLED   // cancelled by seller; remaining returned to wallet
}

enum P2PTradeStatus {
  PENDING_PAYMENT  // PLS escrowed; waiting for buyer to pay off-platform
  PAID             // buyer marked paid; waiting for seller confirmation
  RELEASED         // seller confirmed; PLS transferred to buyer
  CANCELLED        // expired, or cancelled before payment
  DISPUTED         // admin reviewing
}

model P2POffer {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @map("seller_id") @db.Uuid
  // Price seller wants per 1 PLS, in USD. UI converts to user's display
  // currency via the live FX rates from /api/v1/price.
  pricePerPlsUsd  Decimal          @map("price_per_pls_usd") @db.Decimal(18, 9)
  totalAmount     BigInt           @map("total_amount")
  remainingAmount BigInt           @map("remaining_amount")
  // Per-trade limits. 0 means no limit.
  minTrade        BigInt           @default(0) @map("min_trade")
  maxTrade        BigInt           @default(0) @map("max_trade")
  // Free-form text: payment instructions, requisites, terms.
  // Buyer reads this before opening a trade.
  terms           String           @db.VarChar(800)
  status          P2POfferStatus   @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  seller User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  trades P2PTrade[]

  @@index([status, createdAt(sort: Desc)])
  @@index([sellerId])
  @@map("p2p_offers")
}

model P2PTrade {
  id            String         @id @default(uuid()) @db.Uuid
  offerId       String         @map("offer_id") @db.Uuid
  buyerId       String         @map("buyer_id") @db.Uuid
  sellerId      String         @map("seller_id") @db.Uuid
  amount        BigInt
  // Total fiat owed by buyer (USD); locked at the offer's price at open.
  totalPriceUsd Decimal        @map("total_price_usd") @db.Decimal(18, 9)
  status        P2PTradeStatus @default(PENDING_PAYMENT)
  // Free-form note from buyer when marking paid (e.g., transaction id).
  paymentNote   String?        @db.VarChar(500) @map("payment_note")
  paidAt        DateTime?      @map("paid_at")
  releasedAt    DateTime?      @map("released_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  // Auto-cancel deadline if buyer hasn't paid (default +30 min).
  expiresAt     DateTime       @map("expires_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  offer  P2POffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  buyer  User     @relation("p2pBuyerTrades", fields: [buyerId], references: [id], onDelete: Cascade)
  seller User     @relation("p2pSellerTrades", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("p2p_trades")
}

// ─── E2E KEY BUNDLES ────────────────────────────────────

model UserKeyBundle {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @unique @map("user_id") @db.Uuid
  identityKeyPub  String @map("identity_key_pub")
  preKeyPub       String @map("pre_key_pub")
  preKeySignature String @map("pre_key_signature")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_key_bundles")
}

// One row per linked device. Replaces the single-bundle-per-user model
// so a user can have e.g. desktop + iPhone + Android with independent
// keypairs. Senders fetch every device's pubkey and encrypt N copies;
// each receiving device decrypts only its own copy.
model UserDevice {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  // Stable per-device label shown in Settings (e.g. "Chrome on Windows",
  // "iPhone 15 / Safari"). Best-effort, derived from User-Agent.
  deviceName      String?  @map("device_name") @db.VarChar(64)
  identityKeyPub  String   @map("identity_key_pub")
  preKeyPub       String   @map("pre_key_pub")
  preKeySignature String   @map("pre_key_signature")
  createdAt       DateTime @default(now()) @map("created_at")
  // Bumped on every E2E init / sign-in handshake so the Settings list
  // can sort by recency and the UI can flag dormant devices.
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // identityKeyPub is the natural key for a device. Keeps re-registration
  // idempotent (upsert on duplicate) and prevents a device from
  // accidentally registering twice.
  @@unique([userId, identityKeyPub])
  @@index([userId])
  @@map("user_devices")
}

// ─── NFT CACHE ──────────────────────────────────────────

model NftCache {
  id           String   @id @default(uuid()) @db.Uuid
  mintAddress  String   @unique @map("mint_address") @db.VarChar(64)
  ownerWallet  String   @map("owner_wallet") @db.VarChar(64)
  name         String?  @db.VarChar(128)
  imageUrl     String?  @map("image_url")
  collection   String?  @db.VarChar(64)
  lastVerified DateTime @default(now()) @map("last_verified")

  @@index([ownerWallet])
  @@map("nft_cache")
}

// ─── BOTS ───────────────────────────────────────────────

model Bot {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  tokenHash       String    @map("token_hash")
  tokenPlain      String?   @map("token_plain")
  startMessage    String?   @map("start_message") @db.VarChar(512)
  webhookUrl      String?   @map("webhook_url")
  webhookSecret   String?   @map("webhook_secret")
  commands        Json?     @default("[]")
  isActive        Boolean   @default(true) @map("is_active")
  isSystemBot     Boolean   @default(false) @map("is_system_bot")
  lastSeenAt      DateTime? @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user    User        @relation("botUser", fields: [userId], references: [id], onDelete: Cascade)
  owner   User        @relation("botOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  updates BotUpdate[]

  @@index([ownerId])
  @@map("bots")
}

model BotUpdate {
  id        String   @id @default(uuid()) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  type      String   @db.VarChar(32)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, createdAt(sort: Desc)])
  @@map("bot_updates")
}

// ─── MODERATION ─────────────────────────────────────────

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  messageId  String       @map("message_id") @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reason     ReportReason
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")

  message     Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter    User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  votes       ModVote[]
  punishments UserPunishment[]

  @@index([status])
  @@index([messageId])
  @@map("reports")
}

model ModVote {
  id          String     @id @default(uuid()) @db.Uuid
  reportId    String     @map("report_id") @db.Uuid
  moderatorId String     @map("moderator_id") @db.Uuid
  verdict     ModVerdict
  createdAt   DateTime   @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, moderatorId])
  @@map("mod_votes")
}

model UserPunishment {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      PunishmentType
  expiresAt DateTime?      @map("expires_at")
  reason    String?        @db.VarChar(256)
  reportId  String?        @map("report_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_punishments")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @map("user_agent") @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum ReportReason {
  SPAM
  HARASSMENT
  ILLEGAL
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED_WARN
  RESOLVED_MUTE
  RESOLVED_BAN
  DISMISSED
}

enum ModVerdict {
  WARN
  MUTE_1H
  MUTE_24H
  MUTE_7D
  BAN_30D
  BAN_PERM
  DISMISS
}

enum PunishmentType {
  WARN
  MUTE
  BAN
}
